ENABLE_CHAT=true
CHAT_URL=https://bedrock-mantle.us-west-2.api.aws/openai/v1
CHAT_MODEL=google.gemma-4-31b
CHAT_REASONING_MODEL=google.gemma-4-31b
EMBED_URL=https://api.deepinfra.com/v1/openai
EMBED_MODEL=google/embeddinggemma-300m
EMBED_API_KEY=

# Web search uses DuckDuckGo and needs no API key. A Brave key switches search to Brave.
# Vector and graph calls use the session knowledge MCP server unless Qdrant or Neo4j is configured.
MCP_WEB=true
BRAVE_API_KEY=
DDG_REGION=in-en
MCP_FETCH_URL=
MCP_VECTOR=true
QDRANT_URL=
QDRANT_LOCAL_PATH=
QDRANT_API_KEY=
COLLECTION_NAME=cam-1842
MCP_GRAPH=true
NEO4J_MCP_URI=bolt://localhost:7687
NEO4J_MCP_USERNAME=neo4j
NEO4J_MCP_PASSWORD=
NEO4J_MCP_DATABASE=neo4j
